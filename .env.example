# Server-side keys for the /api serverless proxies.
# Copy to .env for `vercel dev`, and set the same variables in the Vercel
# dashboard (Project → Settings → Environment Variables) for deployments.
# These never reach the browser.
YOUTUBE_API_KEY=your-youtube-data-api-key
GEMINI_API_KEY=your-gemini-api-key

# Supabase service-role key — server-side only, bypasses Row-Level Security.
# Used exclusively by the admin API functions (api/admin-*.mjs). Get these
# from Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login — fully separate from Supabase Auth/user accounts. Set a strong
# password and a random secret (e.g. `openssl rand -hex 32`) used to sign the
# admin session cookie.
ADMIN_PASSWORD=set-a-strong-password
ADMIN_SESSION_SECRET=set-a-random-32-byte-secret

# Waitlist approval emails — optional. Leave unset to skip email on approve.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Trellis <onboarding@yourdomain.com>
# APP_URL=https://your-production-url.vercel.app
